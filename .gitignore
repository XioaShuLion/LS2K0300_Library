# ============================================================================
# LS2K0300_Library 仓库根 .gitignore（适配版）
#
# 说明：
#   * 仓库根同时包含 Linux 内核源码树 linux-4.19-202506/，该内核树自带了完整的
#     .gitignore（含 arch/* 等各子目录），因此本文件不再重复内核相关规则。
#   * 本文件主要覆盖 LS2K300_Library/（开源库 + 各例程）的构建产物与编辑环境。
#   * 重要：.gitignore 只对“未跟踪(untracked)”文件生效。若某文件已被提交，
#     需要执行 `git rm -r --cached <路径>` 才能停止跟踪，光靠这里不会删。
#
#   修改后建议自查：
#     git status --ignored                          # 查看被忽略的文件
#     git ls-files -c -i --exclude-standard         # 查看“已跟踪但会被忽略”的文件
# ============================================================================

# ---------------------------------------------------------------------------
# 1) 各例程的编译输出目录（build.sh 会把产物写到各例程的 out/ 下）
#    仅忽略 out/ 内部内容，保留占位文件“本文件夹作用.txt”
#    注意：内核树自带 .gitignore，因此这里统一限定在 LS2K300_Library/ 内，
#          避免通用 build/ 误伤内核源码（如 linux-4.19-202506/tools/build/）
# ---------------------------------------------------------------------------
LS2K300_Library/**/out/*
!LS2K300_Library/**/out/本文件夹作用.txt
LS2K300_Library/**/build/

# ---------------------------------------------------------------------------
# 2) 编译 / 链接产生的中间文件（限定在 LS2K300_Library/ 内，避免误伤内核树）
# ---------------------------------------------------------------------------
LS2K300_Library/**/*.o
LS2K300_Library/**/*.o.*
LS2K300_Library/**/*.d
LS2K300_Library/**/*.a
LS2K300_Library/**/*.so
LS2K300_Library/**/*.so.dbg
LS2K300_Library/**/*.ko
LS2K300_Library/**/*.mod.c
LS2K300_Library/**/*.lst
LS2K300_Library/**/*.dwo
LS2K300_Library/**/*.gcno
LS2K300_Library/**/*.su
LS2K300_Library/**/*.symtypes
LS2K300_Library/**/*.elf
LS2K300_Library/**/Module.symvers
LS2K300_Library/**/modules.builtin

# ---------------------------------------------------------------------------
# 3) 放行：工程编译所必需的预编译静态库
#    （必须写在上面 *.a 规则之后，否则放行无效）
# ---------------------------------------------------------------------------
!LS2K300_Library/**/zf_components/**/lib/*.a
!LS2K300_Library/**/lib/*.a
!LS2K300_Library/**/libs/*.a

# ---------------------------------------------------------------------------
# 4) 模型 / 二进制资源
#    例程模型为 *.tflite（默认不忽略）；如确有需要提交的 *.bin 请在此放行
# ---------------------------------------------------------------------------
LS2K300_Library/**/*.bin
!LS2K300_Library/**/models/**/*.bin

# ---------------------------------------------------------------------------
# 5) 编辑器 / 系统 / 备份文件
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
*.orig
*.bak
.DS_Store

# ---------------------------------------------------------------------------
# 6) 不要把 .gitignore 自身忽略掉
# ---------------------------------------------------------------------------
!.gitignore
